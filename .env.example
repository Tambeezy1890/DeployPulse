# Local Docker Compose overrides. Never commit real secrets.
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-value
REFRESH_TOKEN_SECRET=replace-with-another-long-random-value
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_SETUP_STATE_SECRET=replace-with-a-long-random-value
# Generate with: openssl rand -hex 32
NOTIFICATION_ENCRYPTION_KEY=replace-with-a-64-character-hexadecimal-value
HEALTH_CHECK_INTERVAL_MS=300000
