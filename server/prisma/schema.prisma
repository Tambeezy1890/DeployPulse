generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  name                 String
  passwordHash         String
  refreshToken         String?      @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  role                 Role         @default(USER)
  projects             Project[]
  triggeredDeployments Deployment[]
}

model Project {
  id          String       @id @default(cuid())
  name        String
  slug        String
  description String?
  repository  String?
  provider    Provider?

  githubRepoFullName String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deployments Deployment[]
  healthCheckUrl String?
  monitoringEnabled  Boolean      @default(false)
  healthChecks HealthCheck[]
  monitorStatus          MonitorStatus @default(PENDING)
consecutiveFailures    Int           @default(0)
consecutiveSuccesses   Int           @default(0)
monitorStatusChangedAt DateTime?
lastCheckedAt          DateTime?


@@index([githubRepoFullName])
  @@unique([ownerId, slug])
  @@index([ownerId])
}

model Deployment {
  id            String           @id @default(cuid())
  status        DeploymentStatus @default(PENDING)
  environment   Environment      @default(PRODUCTION)
  source     DeploymentSource @default(MANUAL)
externalId String?
  branch        String?
  commitSha     String?
  commitMessage String?
  deploymentUrl String?
  logsUrl       String?
  startedAt     DateTime?         @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  externalUpdatedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@unique([projectId, source, externalId])
  @@index([projectId])
  @@index([triggeredById])
  @@index([status])
  
}
model HealthCheck {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId],references: [id],onDelete: Cascade)

  checkedUrl     String
  status         HealthStatus
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime     @default(now())

  @@index([projectId, checkedAt])
}

enum HealthStatus {
  UP
  DOWN
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum Environment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum Provider {
  VERCEL
  RENDER
  RAILWAY
  NETLIFY
  AWS
  OTHER
}

enum Role {
  USER
  ADMIN
}
enum MonitorStatus {
  PENDING
  HEALTHY
  DEGRADED
  DOWN
  RECOVERING
}
enum DeploymentSource {
  MANUAL
  GITHUB
}