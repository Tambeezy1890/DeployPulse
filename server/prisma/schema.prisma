generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String
  passwordHash         String
  refreshToken         String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  role                 Role                 @default(USER)
  projects             Project[]
  githubInstallations  GitHubInstallation[]
  triggeredDeployments Deployment[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  slug        String
  description String?
  repository  String?
  provider    Provider?

  githubRepoFullName String?

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  ownerId                String
  owner                  User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deployments            Deployment[]
  healthCheckUrl         String?
  monitoringEnabled      Boolean       @default(false)
  healthChecks           HealthCheck[]
  incidents              Incident[]
  monitorStatus          MonitorStatus @default(PENDING)
  consecutiveFailures    Int           @default(0)
  consecutiveSuccesses   Int           @default(0)
  monitorStatusChangedAt DateTime?
  lastCheckedAt          DateTime?
  githubRepositoryId     String?

  githubRepository GitHubRepository? @relation(fields: [githubRepositoryId], references: [id], onDelete: SetNull)

  @@unique([ownerId, slug])
  @@index([githubRepositoryId])
  @@index([githubRepoFullName])
  @@index([ownerId])
}

model Deployment {
  id                String           @id @default(cuid())
  status            DeploymentStatus @default(PENDING)
  environment       Environment      @default(PRODUCTION)
  source            DeploymentSource @default(MANUAL)
  externalId        String?
  branch            String?
  commitSha         String?
  commitMessage     String?
  deploymentUrl     String?
  logsUrl           String?
  startedAt         DateTime?        @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  externalUpdatedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@unique([projectId, source, externalId])
  @@index([projectId])
  @@index([triggeredById])
  @@index([status])
}

model HealthCheck {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  checkedUrl     String
  status         HealthStatus
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime     @default(now())

  @@index([projectId, checkedAt])
}

model Incident {
  id String @id @default(cuid())

  title    String
  summary  String?
  status   IncidentStatus   @default(OPEN)
  severity IncidentSeverity
  cause    IncidentCause

  openedAt       DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  resolvedAt     DateTime?

  // Only open incidents have this value.
  // PostgreSQL allows multiple null values in a unique column.
  activeKey String? @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  events IncidentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, status])
  @@index([severity])
  @@index([openedAt])
}

model IncidentEvent {
  id String @id @default(cuid())

  type    IncidentEventType
  message String

  // ID of the deployment or health check that produced the event.
  sourceId String?

  // Prevents repeated webhooks from adding duplicate timeline events.
  dedupeKey String? @unique

  metadata Json?

  createdAt DateTime @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model GitHubInstallation {
  id                   String    @id @default(cuid())
  githubInstallationId String    @unique
  githubAccountId      String
  githubAccountLogin   String
  githubAccountType    String
  repositorySelection  String
  suspendedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  repositories GitHubRepository[]

  @@index([ownerId])
  @@index([githubAccountLogin])
}

model GitHubRepository {
  id                 String   @id @default(cuid())
  githubRepositoryId String   @unique
  name               String
  fullName           String
  htmlUrl            String
  private            Boolean
  defaultBranch      String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  installationId String
  installation   GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  projects Project[]

  @@index([installationId])
  @@index([fullName])
}

enum HealthStatus {
  UP
  DOWN
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum Environment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum Provider {
  VERCEL
  RENDER
  RAILWAY
  NETLIFY
  AWS
  OTHER
}

enum Role {
  USER
  ADMIN
}

enum MonitorStatus {
  PENDING
  HEALTHY
  DEGRADED
  DOWN
  RECOVERING
}

enum DeploymentSource {
  MANUAL
  GITHUB
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum IncidentSeverity {
  WARNING
  CRITICAL
}

enum IncidentCause {
  DEPLOYMENT
  HEALTH
  COMBINED
}

enum IncidentEventType {
  DEPLOYMENT_FAILED
  HEALTH_DEGRADED
  HEALTH_DOWN
  HEALTH_RECOVERING
  HEALTHY
  INCIDENT_OPENED
  INCIDENT_ESCALATED
  INCIDENT_RESOLVED
}
